# Skopiuj do .env.local i uzupelnij wartosciami z Supabase → Settings → API.
#
# Oba klucze sa JAWNE z zalozenia - anon key trafia do zbudowanego JS
# i dostepu do danych pilnuje Row Level Security po stronie bazy.
# HASLO DO BAZY NIE NALEZY TU WPISYWAC. Aplikacja go nie uzywa.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Uzywane wylacznie przez scripts/dump-supabase.mjs, uruchamiany na Macu:
#   node --env-file=.env.local scripts/dump-supabase.mjs
POMODORE_EMAIL=
POMODORE_PASSWORD=
